{
  "if statement": {
    "prefix": "if",
    "body": ["if [[ ${1:condition} ]]; then", "\t${2:commands}", "fi"],
    "description": "if block"
  },
  "if else": {
    "prefix": "ifelse",
    "body": ["if [[ ${1:condition} ]]; then", "\t${2:commands}", "else", "\t${3:commands}", "fi"],
    "description": "if / else block"
  },
  "if elif else": {
    "prefix": "ifelif",
    "body": ["if [[ ${1:condition} ]]; then", "\t${2:commands}", "elif [[ ${3:condition} ]]; then", "\t${4:commands}", "else", "\t${5:commands}", "fi"],
    "description": "if / elif / else block"
  },
  "for loop": {
    "prefix": "for",
    "body": ["for ${1:item} in ${2:list}; do", "\t${3:commands}", "done"],
    "description": "for ... in loop"
  },
  "for loop C-style": {
    "prefix": "forc",
    "body": ["for ((${1:i}=0; ${1:i}<${2:10}; ${1:i}++)); do", "\t${3:commands}", "done"],
    "description": "C-style for loop"
  },
  "while loop": {
    "prefix": "while",
    "body": ["while [[ ${1:condition} ]]; do", "\t${2:commands}", "done"],
    "description": "while loop"
  },
  "read file lines": {
    "prefix": "whileread",
    "body": ["while IFS= read -r line; do", "\t${2:echo \"\\$line\"}", "done < \"${1:file}\""],
    "description": "read a file line by line"
  },
  "case statement": {
    "prefix": "case",
    "body": ["case \"\\$${1:var}\" in", "\t${2:pattern})", "\t\t${3:commands}", "\t\t;;", "\t*)", "\t\t${4:commands}", "\t\t;;", "esac"],
    "description": "case block"
  },
  "function": {
    "prefix": "function",
    "body": ["${1:name}() {", "\t${2:commands}", "}"],
    "description": "function definition"
  },
  "shebang": {
    "prefix": "bashhead",
    "body": ["#!/usr/bin/env bash", "set -euo pipefail", "", "$0"],
    "description": "script header with safe options"
  }
}